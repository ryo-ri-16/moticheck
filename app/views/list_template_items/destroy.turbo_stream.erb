<%= turbo_stream.remove @list_template_item %>

<%= turbo_stream.update "flash_messages" do %>
  <div class="bg-green-100 text-green-800 p-3 rounded mb-4"
        data-controller="toast">
    アイテムを削除しました
  </div>
<% end %>

<%= turbo_stream.replace "list_template_items" do %>
  <%= render "list_templates/items",
        list_template: @list_template,
        template_items: @list_template.list_template_items %>
<% end %>
