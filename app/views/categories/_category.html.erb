<div class="group p-4 flex justify-between items-center hover:bg-gray-50 transition-colors">
  <div class="flex items-center gap-3 flex-1">
    <%# カテゴリーアイコン %>
    <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
      </svg>
    </div>

    <%# カテゴリー情報 %>
    <div class="flex-1">
      <span class="text-gray-900 font-medium"><%= category.name %></span>
      <% if category.lists.exists? %>
        <p class="text-xs text-gray-500 mt-1">
          <%= category.lists.count %> 件のタスク
        </p>
      <% end %>
    </div>
  </div>

  <%# メニューボタン %>
  <div data-controller="menu" class="relative">
    <button
      data-action="click->menu#toggle"
      class="p-2 hover:bg-gray-200 rounded-lg transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100"
      aria-label="メニューを開く"
    >
      <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
      </svg>
    </button>

    <%# ドロップダウンメニュー %>
    <div
      data-menu-target="menu"
      class="absolute right-0 mt-2 bg-white shadow-lg rounded-lg overflow-hidden hidden z-30 w-36 border border-gray-200"
    >
      <%= link_to edit_category_path(category),
          data: { turbo_frame: dom_id(category) },
          class: "flex items-center gap-2 px-4 py-2.5 hover:bg-gray-50 text-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        編集
      <% end %>

      <div class="border-t border-gray-200"></div>

      <%= button_to category_path(category),
          method: :delete,
          data: {
            turbo_confirm: "「#{category.name}」を削除しますか？\n※ このカテゴリーのタスクは「未分類」に移動されます"
          },
          class: "flex items-center gap-2 w-full text-left px-4 py-2.5 hover:bg-red-50 text-red-600 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        削除
      <% end %>
    </div>
  </div>
</div>
