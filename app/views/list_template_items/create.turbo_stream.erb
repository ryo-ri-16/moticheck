<%= turbo_stream.replace "list_template_items" do %>
  <%= render "list_templates/items",
        list_template: @list_template,
        template_items: @list_template.list_template_items.reload %>
<% end %>

<%= turbo_stream.replace "item_form" do %>
  <%= render "list_templates/items_add",
        list_template: @list_template,
        list_template_item: ListTemplateItem.new %>
<% end %>
