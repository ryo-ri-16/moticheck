<div class="bg-white rounded-lg shadow-sm p-4 space-y-4">
  <div class="border-b pb-3 mb-4">
    <% if list_template.new_record? %>
      <h2 class="text-xl font-bold text-gray-800">
        📃 新しいテンプレートを作成
      </h2>
      <p class="text-sm text-gray-600 mt-1">
        テンプレートの基本情報を入力してください
      </p>
    <% else %>
      <h2 class="text-xl font-bold text-gray-800">
        📃 テンプレートを編集
      </h2>
      <p class="text-sm text-gray-600 mt-1">
        「<%= list_template.title %>」の設定を変更できます
      </p>
    <% end %>
  </div>

  <%= form_with model: list_template do |f| %>
    <%= render "shared/error_messages", object: f.object %>

    <div class="space-y-2">
      <%= f.label :title, class: "block text-sm font-medium text-gray-700" do %>
        タイトル(必須) <span class="text-red-700">*</span>
      <% end %>
      <%= f.text_field :title,
        class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        placeholder: "例: 買い物リスト" %>
    </div>

    <div class="mb-4 mt-2">
      <%= f.label :category_id, "カテゴリー", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.select :category_id,
      options_from_collection_for_select(
        @categories, :id, :name, f.object.category_id
      ),
      { include_blank: '未分類' },
      class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>

      <div class="mt-2">
        <label class="flex items-center text-sm text-gray-600">
          <input type="checkbox" id="new_category_toggle" class="mr-2">
          新しいカテゴリーを作成
        </label>

        <div id="new_category_field" class="mt-2 hidden">
          <%= text_field_tag :new_category_name, nil,
            placeholder: "新しいカテゴリー名",
            class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
      </div>
    </div>

    <div class="space-y-2 mt-4">
      <%= f.label :description, class: "block text-sm font-medium text-gray-700" do %>
        説明
        <span class="text-xs text-gray-500 font-normal">(任意)</span>
      <% end %>
      <%= f.text_area :description,
        class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none",
        rows: 2,
        placeholder: "このテンプレートの使い方や目的を記入" %>
    </div>

    <div data-controller="accordion" class="mt-6 border rounded-md">
      <button type="button"
              data-action="click->accordion#toggle"
              class="w-full flex justify-between items-center px-4 py-3 bg-gray-50 hover:bg-gray-100 text-left">
        <span class="font-medium text-gray-700">
          🔁 繰り返し設定
        </span>
        <span data-accordion-target="arrow" class="transition-transform duration-200">▼</span>
      </button>

      <div data-accordion-target="content"
          data-controller="repeat"
          class="hidden px-4 py-4 border-t space-y-6">

        <!-- ① 繰り返し方法 -->
        <div class="space-y-2">
          <p class="font-medium text-gray-700">🔁 繰り返し方法</p>

          <div class="flex gap-4">
            <label class="flex items-center space-x-2 cursor-pointer">
              <%= f.radio_button :repeat_type, "no_repeat",
                    checked: list_template.repeat_type == "no_repeat" || list_template.new_record?,
                    data: { action: "change->repeat#toggle" },
                    class: "form-radio" %>
              <span>なし</span>
            </label>

            <label class="flex items-center space-x-2 cursor-pointer">
              <%= f.radio_button :repeat_type, "daily",
                    checked: list_template.repeat_type == "daily",
                    data: { action: "change->repeat#toggle" },
                    class: "form-radio" %>
              <span>毎日</span>
            </label>

            <label class="flex items-center space-x-2 cursor-pointer">
              <%= f.radio_button :repeat_type, "weekly",
                    checked: list_template.repeat_type == "weekly",
                    data: { action: "change->repeat#toggle" },
                    class: "form-radio" %>
              <span>毎週</span>
            </label>
          </div>
        </div>

        <!-- ② 曜日選択（weeklyのときだけ表示） -->
        <div data-repeat-target="weeklySection"
            class="<%= 'hidden' unless list_template.repeat_type == 'weekly' %> space-y-3">
          <div>
            <p class="font-medium text-gray-700">📅 繰り返す曜日を選択（複数可）</p>
            <p class="text-sm text-gray-500 mt-1">
              チェックした曜日にリストが生成されます
            </p>
          </div>

          <div class="grid grid-cols-7 gap-2">
            <% ListTemplate::WEEKDAY_BITS.keys.each do |day| %>
              <label class="weekday-checkbox-label">
                <%= check_box_tag "list_template[weekdays][]", 
                  day,
                  list_template.weekdays.include?(day),
                  id: "weekday_#{day}",
                  class: "hidden weekday-checkbox" %>
                <span class="weekday-button">
                  <%= ListTemplate::WEEKDAY_NAMES[day] %>
                </span>
              </label>
            <% end %>
          </div>

          <!-- 選択された曜日の表示 -->
          <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-md">
            <p class="text-sm text-blue-800">
              💡 選択した曜日にリストが自動生成されます
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex gap-2 mt-4">
      <% if list_template.new_record? %>
        <%= f.submit "作成する",
          class: "flex-1 px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-semibold transition-colors shadow-sm" %>
      <% else %>
        <%= f.submit "変更を保存する",
          class: "flex-1 px-4 py-3 bg-green-600 hover:bg-green-700 text-white rounded-md font-semibold transition-colors shadow-sm" %>
        <%= link_to "キャンセル", @back_path || list_template_path(list_template),
          class: "flex-1 text-center px-4 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-md font-semibold transition-colors" %>
      <% end %>
    </div>
    <% unless list_template.new_record? %>
      <%= button_to "このテンプレートを削除",
        list_template_path(list_template),
        method: :delete,
        data: {
          turbo_confirm: "本当に削除しますか？",
          turbo_method: :delete
        },
        class: "w-full mt-2 px-4 py-2 bg-white border-2 border-red-500 text-red-600 hover:bg-red-50 rounded-md font-semibold transition-colors" %>
    <% end %>
  <% end %>
</div>

<div class="mt-3 p-3 <%= list_template.new_record? ? 'bg-blue-50 border-blue-200' : 'bg-green-50 border-green-200' %> border rounded-md">
  <% if list_template.new_record? %>
    <p class="text-sm text-blue-800">
      💡 テンプレートはリストにすることができます
    </p>
  <% else %>
    <p class="text-sm text-green-800">
      ⚠️ 変更内容は保存後すぐに反映されます
    </p>
  <% end %>
</div>

<script>
  document.getElementById('new_category_toggle')?.addEventListener('change', function(e) {
    const field = document.getElementById('new_category_field');
    const select = document.querySelector('select[name="list_template[category_id]"]');

    if (e.target.checked) {
      field.classList.remove('hidden');
      select.disabled = true;
    } else {
      field.classList.add('hidden');
      select.disabled = false;
    }
  });
</script>
