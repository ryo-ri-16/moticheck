<div class="fixed top-5 right-5 z-50 space-y-3 w-80">
  <% flash.each do |key, message| %>
    <% alert_class = case key.to_s
        when "notice", "success"
          "bg-green-50 border border-green-300 text-green-700"
        when "alert", "danger"
          "bg-red-50 border border-red-300 text-red-700"
        else
          "bg-gray-50 border border-gray-300 text-gray-700"
        end %>

    <div
      data-controller="flash"
      data-flash-timeout-value="2000"
      class="px-4 py-3 rounded shadow-lg transition-all duration-300 <%= alert_class %>"
      role="alert">
      <span><%= message %></span>
      <button data-action="click->flash#close">×</button>
    </div>
  <% end %>
</div>
