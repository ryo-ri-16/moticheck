<% content_for :title, "テンプレート" %>

<div class="container py-4 pb-24">
  <% if current_user.guest? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <p class="text-sm text-gray-700 flex items-start gap-2">
        <i class="fas fa-info-circle text-yellow-600 mt-0.5"></i>
        <span>
          テンプレート作成は
          <%= link_to "ユーザー登録", guest_sign_up_path, class: "text-blue-600 underline font-bold" %>
          後にご利用できます
        </span>
      </p>
    </div>
  <% end %>

  <section class="mb-6">
    <h2 class="text-xl font-bold mb-4">お気に入りテンプレート</h2>
    <% if @user_templates.present? %>
      <div class="space-y-4">
        <%= render partial: 'list_template', collection: @user_templates, locals: { deletable: true } %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "テンプレートはありません" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="text-xl font-bold mb-4">初期テンプレート</h2>
    <% if @global_templates.present? %>
      <div class="space-y-4">
        <%= render partial: 'list_template', collection: @global_templates, locals: { deletable: false } %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "テンプレートはありません" %>
    <% end %>
  </section>
</div>