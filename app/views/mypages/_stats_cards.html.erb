<div class="grid grid-cols-2 gap-4 mb-6">
  <div class="bg-white rounded-lg shadow-sm p-4">
    <div class="flex items-center gap-2 mb-2">
      <i class="fas fa-calendar-alt text-blue-600"></i>
      <p class="text-xs text-gray-500 font-medium">登録日</p>
    </div>
    <p class="text-lg font-bold text-gray-800">
      <%= @user.created_at.strftime("%Y/%m/%d") %>
    </p>
  </div>

  <div class="bg-white rounded-lg shadow-sm p-4">
    <div class="flex items-center gap-2 mb-2">
      <i class="fas fa-list-check text-green-600"></i>
      <p class="text-xs text-gray-500 font-medium">作成リスト</p>
    </div>
    <p class="text-lg font-bold text-gray-800">
      <% if current_user.guest? %>
        <%= @lists_count %><span class="text-sm text-gray-500">/8件</span>
      <% else %>
        <%= @lists_count %><span class="text-sm text-gray-500">件</span>
      <% end %>
    </p>
  </div>
</div>