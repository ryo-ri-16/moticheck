<% content_for :title, "テンプレート" %>

<div class="container py-6 pb-24 mt-4 max-w-4xl mx-auto">
  <div class="mb-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-2">テンプレートとは</h2>
      <p class="text-sm text-gray-600">
        よく使うリストをテンプレートとして保存し、繰り返し利用できます。
      </p>
  </div>

    <% if current_user.guest? %>
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-4 mb-6 shadow-sm">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0">
            <i class="fas fa-info-circle text-blue-600 text-xl"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800 mb-1">テンプレート作成機能について</p>
            <p class="text-sm text-gray-700">
              よく使うリストをテンプレートとして保存できます。
            </p>
            <p class="text-sm text-gray-700">
              <span>
                テンプレート作成は
                <%= link_to "ユーザー登録", guest_sign_up_path, class: "text-blue-600 underline font-bold" %>
                後に無料でご利用できます
              </span>
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <section class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-3">
          <span class="w-1 h-6 bg-blue-500 rounded"></span>
          <h2 class="text-xl font-bold">マイテンプレート</h2>
        </div>
        <% unless current_user.guest? %>
          <%= link_to new_list_template_path,
              class: "flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors" do %>
            <i class="fas fa-plus text-xs"></i>
            <span>テンプレート作成</span>
          <% end %>
        <% end %>
      </div>
      <p class="text-sm text-gray-600 mb-4">
        自身で作成したテンプレートです。リストで使用したり編集できます。
      </p>
      <% if @user_templates.present? %>
        <div id="list_templates_section" class="space-y-3">
          <%= render partial: 'list_template', collection: @user_templates, locals: { deletable: true } %>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "テンプレートはまだありません" %>
      <% end %>
    </section>

    <section class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-1 h-6 bg-green-500 rounded"></span>
        <h2 class="text-xl font-bold">初期テンプレート</h2>
        <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full font-medium">
          公式
        </span>
      </div>
      <p class="text-sm text-gray-600 mb-4">
        あらかじめ用意されたテンプレートです。
      </p>

      <% if @global_templates.present? %>
        <div class="space-y-3">
          <%= render partial: 'list_template', collection: @global_templates, locals: { deletable: false } %>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "初期テンプレートはありません" %>
      <% end %>
    </section>
</div>
