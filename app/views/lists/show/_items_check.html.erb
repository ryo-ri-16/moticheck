<% checked_items   = list_items.select(&:checked?) %>
<% unchecked_items = list_items.reject(&:checked?) %>
<% checked_count   = checked_items.size %>
<% total_count     = list_items.size %>
<div class="bg-white rounded-lg shadow p-4
      transition-all duration-500 ease-in-out
      <%= 'animate-complete-flash' if @list.completed? %>">
  <%= render "lists/show/items_count",
            checked_count: checked_count,
            total_count: total_count %>
  <div id="items_container">
    <% if list_items.any? %>
      <div class="space-y-2">
        <% list_items.each do |list_item| %>
          <%= render "list_items/list_item",
                list: list,
                list_item: list_item %>
        <% end %>
      </div>
    <% else %>
      <div id="empty_state"
          class="text-center py-12 bg-gray-50 rounded-lg transition-opacity duration-300">
        <svg class="mx-auto h-12 w-12 text-gray-400"></svg>
        <p class="mt-2 text-sm text-gray-500">
          チェック項目がありません
        </p>
      </div>
    <% end %>
  </div>
</div>
