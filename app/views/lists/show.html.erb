<%= render "lists/show/header", list: @list %>

<%= render "lists/show/list_info", list: @list %>

<div id="item_form">
  <%= render "lists/show/item_add",
        list: @list,
        list_item: @list_item || ListItem.new %>
</div>

<div id="list_items">
  <%= render "lists/show/items_check",
        list: @list,
        list_items: @list_items %>
</div>

<% if @list.note.present? %>
  <%= render "lists/show/note", list: @list %>
<% end %>

<div id="list_action_buttons">
  <%= render "lists/show/action_buttons", list: @list %>
</div>