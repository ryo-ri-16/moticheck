<%= content_for :title, "通知一覧" %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">通知一覧</h1>
  </div>

  <h2 class="text-xl font-semibold mb-4 text-gray-700">未読通知</h2>
  <div id="unread-section">
    <%= render "notifications/unread_section",
          unread_notifications: @unread_notifications %>
  </div>

  <div class="mt-8">
    <h2 class="text-xl font-semibold mb-4 text-gray-700">既読通知</h2>

    <div id="read-notifications" class="space-y-3">
      <%= render @read_notifications %>
    </div>
  </div>
</div>
