    <div class="bg-gradient-to-r from-green-50 to-blue-50 border-2 border-green-300 rounded-xl p-6 mb-6 shadow-lg">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <i class="fas fa-check-circle text-4xl text-green-600"></i>
        </div>
        <div class="flex-1">
          <h3 class="text-xl font-bold text-gray-800 mb-3">
            🎉 <%= flash[:first_registration] %>
          </h3>
          <div class="space-y-3">
            <p class="text-gray-700 font-medium">これらの機能が使えるようになりました！</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div class="bg-white rounded-lg p-3 shadow-sm">
                <div class="flex items-center gap-2 mb-1">
                  <i class="fas fa-infinity text-blue-600"></i>
                  <h4 class="font-bold text-gray-800">無制限のリスト作成</h4>
                </div>
                <p class="text-sm text-gray-600">リストを好きなだけ作成できます</p>
              </div>

              <div class="bg-white rounded-lg p-3 shadow-sm">
                <div class="flex items-center gap-2 mb-1">
                  <i class="fas fa-copy text-purple-600"></i>
                  <h4 class="font-bold text-gray-800">テンプレートの作成</h4>
                </div>
                <p class="text-sm text-gray-600">テンプレートを作成することができます</p>
              </div>

              <div class="bg-white rounded-lg p-3 shadow-sm">
                <div class="flex items-center gap-2 mb-1">
                  <i class="fas fa-bell text-yellow-600"></i>
                  <h4 class="font-bold text-gray-800">通知機能</h4>
                </div>
                <p class="text-sm text-gray-600">利用時刻にアプリで通知を受け取れます</p>
              </div>

              <div class="bg-white rounded-lg p-3 shadow-sm">
                <div class="flex items-center gap-2 mb-1">
                  <i class="fas fa-cloud text-indigo-600"></i>
                  <h4 class="font-bold text-gray-800">データの永続保存</h4>
                </div>
                <p class="text-sm text-gray-600">データが自動削除されることはありません</p>
              </div>
            </div>

            <div class="flex gap-3 mt-4">
              <%= link_to new_list_path, class: "flex-1 bg-blue-600 text-white text-center py-3 rounded-lg font-bold hover:bg-blue-700 transition" do %>
                <i class="fas fa-plus mr-2"></i>早速リストを作成
              <% end %>
              <%= link_to list_templates_path, class: "flex-1 bg-purple-600 text-white text-center py-3 rounded-lg font-bold hover:bg-purple-700 transition" do %>
                <i class="fas fa-search mr-2"></i>テンプレートを探す
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>