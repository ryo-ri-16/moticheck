<% content_for :title, "カテゴリー管理" %>

<div class="min-h-screen bg-gray-50 py-8">
  <div class="container max-w-3xl mx-auto px-4">
    <div class="mb-8">
      <p class="text-gray-600">カテゴリーを追加・編集して、整理しましょう</p>
    </div>

    <div class="bg-white rounded-lg shadow-sm mb-6">
      <%= form_with model: @category, local: true do |f| %>
        <div class="p-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            新しいカテゴリー
          </label>

          <div class="flex gap-2">
            <%= f.text_field :name,
                placeholder: "例: 仕事、プライベート、趣味...",
                class: "flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" %>

            <%= f.submit "追加",
                class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors shadow-sm hover:shadow" %>
          </div>

          <% if @category.errors.any? %>
            <div class="mt-2 text-sm text-red-600 flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              <%= @category.errors.full_messages.first %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow-sm">
      <div class="px-4 py-3 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">登録済みカテゴリー</h2>
      </div>

      <% visible_categories = @categories.reject { |c| c.name == "未分類" } %>
      <% if visible_categories.any? %>
        <ul class="divide-y divide-gray-200">
          <% visible_categories.each do |category| %>
            <li>
              <%= turbo_frame_tag dom_id(category) do %>
                <%= render "category", category: category %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="p-8 text-center">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          <p class="text-gray-500 text-lg mb-2">まだカテゴリーがありません</p>
          <p class="text-gray-400 text-sm">上のフォームから最初のカテゴリーを追加しましょう</p>
        </div>
      <% end %>
    </div>

    <div class="mt-6 text-center">
      <%= link_to mypage_path, class: "inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        マイページに戻る
      <% end %>
    </div>
  </div>
</div>
