<div id="<%= dom_id(list_template_item) %>" class="flex items-center gap-3 p-3 bg-gray-50 rounded hover:bg-gray-100 transition-colors">
  <div class="flex-shrink-0 w-6 h-6 flex items-center justify-center bg-white rounded-full text-sm text-gray-600">
    <%= list_template_item.position %>
  </div>

  <div class="flex-1">
    <p class="font-medium"><%= list_template_item.name %></p>
  </div>

  <details class="relative ml-2">
    <summary class="cursor-pointer px-2 py-1 hover:bg-gray-100 rounded transition-colors">⋮</summary>
    <div class="absolute right-0 top-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg z-50 min-w-[120px]">
      <%= link_to "編集",
            edit_list_template_list_template_item_path(list_template_item.list_template, list_template_item),
            data: { turbo_frame: dom_id(list_template_item) },
            class: "block w-full px-4 py-2 text-left text-sm hover:bg-gray-50" %>

      <%= button_to "削除",
            list_template_list_template_item_path(list_template_item.list_template, list_template_item),
            method: :delete,
            data: {
              turbo_confirm: "削除しますか?"
            },
            class: "block w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50 transition-colors rounded-md" %>
    </div>
  </details>
</div>
