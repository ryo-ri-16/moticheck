<%= content_for :title, "MotiCheck" %>

<div class="container py-4 pb-24">
  <section class="mb-6">
    <div class="bg-gradient-to-r from-blue-50 to-blue-100 rounded-lg p-4 border border-blue-200">
      <h1 class="text-xl font-bold text-gray-800 mb-1">
        <%= greeting_message %>
      </h1>
      <p class="text-sm text-gray-600 mb-3">
        <%= summary_message(@checking_lists, @today_lists, @near_lists) %>
      </p>

      <div class="flex gap-3 text-xs">
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
          <span class="text-gray-700">チェック中: <strong><%= @checking_lists.size %></strong></span>
        </div>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 bg-green-500 rounded-full"></span>
          <span class="text-gray-700">今日: <strong><%= @today_lists.size %></strong></span>
        </div>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 bg-yellow-500 rounded-full"></span>
          <span class="text-gray-700">近日: <strong><%= @near_lists.size %></strong></span>
        </div>
      </div>
    </div>
  </section>

  <% if current_user.guest? %>
    <%= render "home/index/guest_list" %>
  <% end %>

  <% if flash[:first_registration] %>
    <%= render "home/index/first_registration" %>
  <% end %>

  <% if @checking_lists.empty? && @today_lists.empty? && @near_lists.empty? && @past_lists.empty? %>
    <div class="bg-white border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
      <div class="mb-4">
        <svg class="w-16 h-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">
        最初のリストを作成しましょう！
      </h3>
      <p class="text-gray-600 text-sm mb-4">
        持ち物リストを作成して、忘れ物を防ぎましょう
      </p>
      <div class="flex items-center justify-center gap-2 text-sm text-gray-500">
        <span>右下の <strong class="text-blue-600">＋ボタン</strong> から作成できます</span>
      </div>
    </div>
  <% end %>

  <div id="home_lists">
    <%= render "home/index/lists_sections",
        checking_lists: @checking_lists,
        today_lists: @today_lists,
        near_lists: @near_lists,
        past_lists: @past_lists %>
  </div>
</div>

<%= render "shared/fab" %>
