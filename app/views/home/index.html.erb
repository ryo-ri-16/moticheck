<% content_for :title, "MotiCheck" %>

<div class="container py-4 pb-24">
  <% if current_user.guest? %>
    <%= render "home/index/guest_list" %>
  <% end %>

  <% if flash[:first_registration] %>
    <%= render "home/index/first_registration" %>
  <% end %>

  <% if @checking_lists.any? %>
    <section class="mb-6">
      <h2 class="text-xl font-bold mb-1 flex items-center gap-2">
        チェック中
        <span class="text-sm text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full">
          <%= @checking_lists.size %>
        </span>
      </h2>
      <p class="text-sm text-gray-500 mb-4">
        現在チェックしているリスト
      </p>

      <div class="space-y-4">
        <%= render @checking_lists %>
      </div>
    </section>
  <% end %>
  <% if @checking_lists.empty? && @today_lists.empty? && @near_lists.empty? && @past_lists.empty? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6 text-center">
      <h3 class="text-lg font-bold text-gray-800 mb-2">
        MotiCheckへようこそ!
      </h3>
      <p class="text-gray-600 text-sm mb-4">
        まだリストがありません。<br>
      </p>
      <div class="flex items-center justify-center gap-2 text-sm text-gray-500">
        <span>右下の<span class="font-bold text-blue-600">＋ボタン</span>から作成できます</span>
      </div>
    </div>
  <% end %>

  <section class="mb-6">
    <h2 class="text-xl font-bold mb-1">今日のリスト(<%= @today_lists.size %>)</h2>
    <p class="text-sm text-gray-500 mb-4">今日使う持ち物リストをチェックしましょう</p>
    <% if @today_lists.any? %>
      <div class="space-y-4">
        <%= render @today_lists %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "今日のリストはありません" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="text-xl font-bold mb-1">近日中のリスト(<%= @near_lists.size %>)</h2>
    <p class="text-sm text-gray-500 mb-4">3日以内に予定されている持ち物リスト</p>
    <% if @near_lists.any? %>
      <div class="space-y-4">
        <%= render @near_lists %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "近日中のリストはありません" %>
    <% end %>
  </section>

  <section class="mb-6">
    <h2 class="text-xl font-bold mb-1">過去の未完了リスト(<%= @past_lists.size %>)</h2>
    <p class="text-sm text-gray-500 mb-4">利用日を過ぎたが完了していないリスト</p>
    <% if @past_lists.any? %>
      <div class="space-y-4">
        <%= render @past_lists %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "全てのリストをチェック済みです!" %>
    <% end %>
  </section>
</div>

<%= render "shared/fab" %>
