<div class="min-h-screen bg-gray-50 pb-24">
  <div class="container mx-auto max-w-2xl px-4 py-6">
    
    <!-- ゲストユーザー向け案内バナー -->
    <% if current_user.guest? %>
      <%= render 'guest_upgrade_banner' %>
    <% end %>
    
    <!-- プロフィールセクション -->
    <%= render 'profile_section', user: @user %>
    
    <!-- 統計情報カード -->
    <%= render 'stats_cards', user: @user, lists_count: @lists_count %>
    
    <!-- アカウント設定グループ -->
    <%= render 'account_settings' %>
    
    <!-- 規約・ポリシーグループ -->
    <%= render 'legal_links' %>
    
    <!-- ログアウトボタン -->
    <%= render 'logout_section' %>
    
    <!-- アカウント削除 -->
    <%= render 'account_deletion' %>
    
  </div>
</div>
