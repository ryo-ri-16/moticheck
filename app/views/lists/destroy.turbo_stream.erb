<%= turbo_stream.remove dom_id(@list) %>

<%= turbo_stream.replace "lists-section" do %>
  <% lists = current_user.lists %>

  <% if lists.any? %>
    <div id="lists-section">
      <div class="space-y-4">
        <%= render lists %>
      </div>
    </div>
  <% else %>
    <div id="lists-section">
      <%= render "shared/empty_state", message: "リストはありません" %>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.replace "list_header" do %>
  <%= render "list_header", lists: current_user.lists %>
<% end %>

<%= turbo_stream.append "flash_messages" do %>
  <div class="bg-green-100 text-green-800 p-3 rounded mb-4 shadow-lg"
        data-controller="toast">
    リストを削除しました
  </div>
<% end %>
