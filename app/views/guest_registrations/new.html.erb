<% content_for :title, "アカウントの本登録" %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8">
    <div class="text-center mb-6">
      <i class="fas fa-user-plus text-4xl text-blue-600 mb-3"></i>
      <h1 class="text-2xl font-bold text-gray-800 mb-2">アカウントの本登録</h1>
      <p class="text-sm text-gray-600">
        メールアドレスとパスワードを設定して、<br>
        すべての機能を利用できるようにしましょう
      </p>
    </div>

    <!-- 現在のデータ引き継ぎを強調 -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <i class="fas fa-check-circle text-green-600 text-xl mt-0.5"></i>
        <div>
          <h3 class="font-bold text-gray-800 mb-1">データはそのまま引き継がれます</h3>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ 作成済みのリスト: <span class="font-bold text-green-700"><%= current_user.lists.count %>件</span></li>
            <li>✓ 登録済みのアイテム: <span class="font-bold text-green-700"><%= current_user.lists.joins(:items).count %>件</span></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-4 mb-4">
      <%= link_to user_google_oauth2_omniauth_authorize_path,
            data: { turbo: false },
            class: "w-full flex items-center justify-center gap-3 border-2 border-gray-300 hover:border-blue-400 hover:bg-blue-50 text-gray-700 py-3 rounded-lg font-semibold transition-all" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span>Googleでログイン</span>
      <% end %>
    </div>

    <%= form_with model: current_user, url: guest_sign_up_path, method: :post, local: true do |f| %>
      <%= render "shared/error_messages", object: f.object %>

      <div class="space-y-4">
        <div class="space-y-2 text-center">
          <%= f.label :name, "名前", class: "block text-sm font-bold text-gray-700 mb-2" %>
          <%= f.text_field :name, autofocus: true, required: true,
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-bold text-gray-700 mb-2" %>
          <%= f.email_field :email,
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "your@email.com",
                autocomplete: "email" %>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "block text-sm font-bold text-gray-700 mb-2" %>
          <%= f.password_field :password,
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "8文字以上",
                autocomplete: "new-password" %>
          <p class="text-xs text-gray-500 mt-1">8文字以上で設定してください</p>
        </div>

        <div>
          <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-sm font-bold text-gray-700 mb-2" %>
          <%= f.password_field :password_confirmation,
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                placeholder: "パスワードを再入力",
                autocomplete: "new-password" %>
        </div>
      </div>

      <div class="mt-6">
        <%= f.submit "登録する",
              class: "w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-4 text-center">
      <%= link_to "キャンセル", root_path, class: "text-sm text-gray-600 hover:text-gray-800" %>
    </div>
  </div>
</div>
