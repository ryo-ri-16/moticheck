<% content_for(:back_path) { list_templates_path } %>
<% content_for :title, @list_template.title %>

<div class="container py-4 pb-24">
  <div class="bg-white rounded-lg shadow-sm p-6">
    <div class="flex items-start justify-between mb-6">
      <div class="flex-1">
        <h1 class="text-2xl font-bold mb-2"><%= @list_template.title %></h1>

        <% if @list_template.category %>
          <span class="inline-block px-3 py-1 text-sm rounded-full bg-gray-100 text-gray-700">
            <%= @list_template.category.name %>
          </span>
        <% end %>
      </div>
    </div>

    <% if @list_template.description.present? %>
      <div class="mt-6">
        <h3 class="text-base font-semibold text-gray-800 mb-3">説明</h3>
        <div class="rounded-lg bg-gray-50 border-l-4 border-blue-400 px-4 py-3">
          <div class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">
            <%= @list_template.description %>
          </div>
        </div>
      </div>
    <% end %>

    <div id="item_form">
      <%= render "items_add",
            list_template: @list_template,
            list_template_item: ListTemplateItem.new %>
    </div>

    <%= render "items", list_template: @list_template, template_items: @template_items %>
  </div>

  <div class="flex gap-2 mt-4 opacity-90">
    <%= button_to "リストへコピー",
        to_lists_list_template_path(@list_template), method: :post,
        class: "flex-1 min-w-[140px] px-4 py-2 border border-gray-300 hover:bg-gray-50 rounded-md text-center font-medium transition-colors" %>

    <% if @list_template.user == current_user && !@list_template.is_initial? %>
      <%= link_to "編集", edit_list_template_path(@list_template),
        class: "flex-1 min-w-[140px] px-4 py-2 border border-gray-300 hover:bg-gray-50 rounded-md text-center font-medium transition-colors" %>
    <% end %>

    <% if @list_template.user == current_user && !@list_template.is_initial? %>
      <%= button_to "削除",
        list_template_path(@list_template),
          method: :delete,
          data: { turbo: false, turbo_confirm: "本当に削除しますか?" },
          class: "flex-1 min-w-[140px] px-4 py-2 text-red-600 border border-red-300 hover:bg-red-50 rounded-md font-medium transition-colors" %>
    <% end %>
  </div>
</div>
