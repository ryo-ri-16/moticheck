<div class="bg-white rounded-xl shadow-sm overflow-hidden mb-6">
  <!-- グループヘッダー -->
  <div class="px-4 py-3 bg-gray-50 border-b">
    <h3 class="text-sm font-semibold text-gray-600 flex items-center gap-2">
      <i class="fas fa-file-contract text-gray-400"></i>
      規約・ポリシー
    </h3>
  </div>
  
  <!-- メニュー項目 -->
  <div class="divide-y">
    <%= link_to term_mypage_path,
                class: "group flex items-center justify-between p-4 hover:bg-gray-50 transition-all" do %>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gray-50 rounded-lg flex items-center justify-center group-hover:bg-gray-100 transition">
          <i class="fas fa-file-lines text-gray-600"></i>
        </div>
        <span class="font-medium text-gray-800">利用規約</span>
      </div>
      <i class="fas fa-chevron-right text-gray-400 group-hover:translate-x-1 transition-transform"></i>
    <% end %>

    <%= link_to privacy_mypage_path,
                class: "group flex items-center justify-between p-4 hover:bg-gray-50 transition-all" do %>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gray-50 rounded-lg flex items-center justify-center group-hover:bg-gray-100 transition">
          <i class="fas fa-shield-halved text-gray-600"></i>
        </div>
        <span class="font-medium text-gray-800">プライバシーポリシー</span>
      </div>
      <i class="fas fa-chevron-right text-gray-400 group-hover:translate-x-1 transition-transform"></i>
    <% end %>
  </div>
</div>
