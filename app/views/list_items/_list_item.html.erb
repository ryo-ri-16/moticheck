<%= turbo_frame_tag dom_id(list_item), class: "relative" do %>
  <div data-card
        class="flex relative items-center p-3 rounded-lg border
              transition-all duration-300 ease-in-out
              <%= list_item.checked? ? 'bg-green-50 opacity-70 border-green-100' :
                'bg-white border-gray-200 hover:border-gray-300 hover:shadow-sm' %>">

    <%# チェックボックス部分 %>
    <% if list_item.persisted? %>
      <%= form_with model: list_item,
            url: check_switching_list_list_item_path(list_item.list, list_item),
            method: :patch,
            data: { turbo_stream: true },
            class: "mr-3" do |f| %>

        <%= f.check_box :checked,
              id: "check_list_item_#{list_item.id}",
              class: "h-5 w-5 text-green-500 rounded focus:ring-2 focus:ring-green-500
              transition-all duration-300 ease-in-out",
              disabled: !list_item.list.checking?,
              onchange: "this.form.requestSubmit()" %>
      <% end %>
    <% end %>

    <%# ラベル部分 %>
    <label for="check_list_item_<%= list_item.id %>"
           class="flex-1 cursor-pointer select-none
           <%= 'line-through text-gray-400' if list_item.checked? %>">
      <%= list_item.item&.name %>
      <% if list_item.quantity.present? && list_item.quantity > 1 %>
        <span class="ml-2 text-sm <%= 'text-gray-400' if list_item.checked? %>">
          ×<%= list_item.quantity %>
        </span>
      <% end %>
    </label>

    <%# アクションメニュー（修正版） %>
    <% if list_item.list.waiting? && list_item.persisted? %>
      <div data-controller="dropdown" class="relative ml-2">
        <button type="button"
                data-action="click->dropdown#toggle">
          ⋮
        </button>

        <div data-dropdown-target="menu"
              class="hidden absolute right-0 top-full mt-1
                      bg-white border border-gray-200
                      rounded-md shadow-lg min-w-[120px]
                      z-50">
            <%= link_to "編集",
                  edit_list_list_item_path(list_item.list, list_item),
                  data: { turbo_frame: dom_id(list_item) },
                  class: "block w-full px-4 py-2 text-left text-sm hover:bg-gray-50" %>

            <%= button_to "削除",
                  list_list_item_path(list_item.list, list_item),
                  method: :delete,
                  data: { turbo_confirm: "削除しますか?" },
                  class: "block w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50 transition-colors rounded-md" %>
        </div>
      </div>
    <% end %>

    <%# チェック済みアイコン %>
    <% if list_item.checked? %>
      <svg class="w-5 h-5 text-green-500 ml-2 animate-scale-in" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd"/>
      </svg>
    <% end %>
  </div>
<% end %>
