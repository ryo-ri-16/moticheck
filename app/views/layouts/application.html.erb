<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= content_for?(:page_title) ? yield(:page_title) : "MotiCheck" %>
    </title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description"
          content="<%= content_for?(:description) ? yield(:description) : "外出・旅行・出勤前の持ち物を簡単にチェックできるWebアプリ" %>">
    <meta property="og:title"
          content="<%= content_for?(:og_title) ? yield(:og_title) : "MotiCheck｜持ち物忘れを防ぐチェックリスト" %>">
    <meta property="og:description"
          content="<%= content_for?(:og_description) ? yield(:og_description) : "持ち物忘れを防ぐチェックリストアプリ。シンプルで使いやすいデザインで、忘れゼロで出かけましょう!" %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://moticheck.onrender.com/">
    <meta property="og:image" content="<%= image_url("moticheck-ogp.png") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50">
    <%= render "shared/header" if user_signed_in?%>

    <div class="container mt-3">
      <%= render 'shared/flash_messages' %>
    </div>
    <main class="pb-20 max-w-md mx-auto">
      <%= yield %>
    </main>

    <%= render "shared/bottom_nav" if user_signed_in? %>
  </body>
</html>
