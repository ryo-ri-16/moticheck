<%= turbo_stream.replace dom_id(@list_template_item) do %>
  <div id="<%= dom_id(@list_template_item) %>"
        data-controller="fade-remove"
        data-action="animationend->fade-remove#remove"
        class="fade-out-wrapper">
    <%= render @list_template_item %>
  </div>
<% end %>

<%= turbo_stream.update "flash_messages" do %>
  <div class="bg-green-100 text-green-800 p-3 rounded mb-4"
        data-controller="toast">
    アイテムを削除しました
  </div>
<% end %>

<%= turbo_stream.update "items_count" do %>
  <%= @list_template.list_template_items_count %>
<% end %>

<% if @list_template.list_template_items_count.zero? %>
  <%= turbo_stream.update "items_container" do %>
    <div id="empty_state">
      <%= render "shared/empty_state", message: "アイテムがありません" %>
    </div>
  <% end %>
<% end %>
