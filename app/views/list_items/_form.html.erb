<%= form_with model: [list, list_item] do |f| %>
  <div class="mb-3">
    <%= f.text_field :item_name,
          placeholder: "アイテム名",
          class: "w-full px-3 py-2 border rounded-md" %>
  </div>

  <div class="flex items-center gap-2 mb-2">
    <%= f.label :quantity, "数量:" %>
    <%= f.number_field :quantity, min: 1, max: 999,
          class: "w-20 px-2 py-2 border rounded-md" %>
    <%= f.submit list_item.persisted? ? "更新" : "追加",
          class: "px-4 py-2 bg-blue-600 text-white rounded-md" %>

    <% if list_item.persisted? %>
      <%= link_to "キャンセル",
            list_list_item_path(list_item.list, list_item),
            data: { turbo_frame: dom_id(list_item) },
            class: "px-4 py-2 bg-gray-400 text-white rounded-md" %>
    <% end %>
  </div>
<% end %>
