<turbo-frame id="<%= dom_id(list_template_item) %>"
  class="<%= 'fade-in-item' if local_assigns[:animated] %>">
  <div data-card
        class="flex relative items-center p-3 rounded-lg border
              transition-all duration-300 ease-in-out
              bg-white border-gray-200 hover:border-gray-300 hover:shadow-sm">
    <div class="flex-1">
      <p class="font-medium"><%= list_template_item.name %></p>
    </div>

    <% if list_template_item.persisted? %>
      <div data-controller="dropdown" class="relative ml-2">
        <button type="button"
                data-action="click->dropdown#toggle">
          ⋮
        </button>

        <div data-dropdown-target="menu"
              class="hidden absolute right-0 top-full mt-1
                      bg-white border border-gray-200
                      rounded-md shadow-lg min-w-[120px]
                      z-50">
          <%= link_to "編集",
                edit_list_template_list_template_item_path(list_template_item.list_template, list_template_item),
                data: { turbo_frame: dom_id(list_template_item) },
                class: "block w-full px-4 py-2 text-left text-sm hover:bg-gray-50" %>

          <%= button_to "削除",
                list_template_list_template_item_path(list_template_item.list_template, list_template_item),
                method: :delete,
                data: {
                  turbo_confirm: "削除しますか?"
                },
                class: "block w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50 transition-colors rounded-md" %>
        </div>
      </div>
    <% end %>
  </div>
</turbo-frame>
